// staging (`gmail-mcp-staging`) が `gmail-mcp.ippoan.org` を bind する実稼働 env
// (ci-dashboard / secrets-inventory と同じ staging=prod パターン)。top-level は
// `wrangler dev` / 予約 production 用。
{
  "name": "gmail-mcp",
  "account_id": "24b45709d060d957340180e995f0d373",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_ORIGIN": "https://gmail-mcp.ippoan.org",
    "GOOGLE_CLIENT_ID": "747065218280-o3r2c16h8e5023393hjiam2o87f495df.apps.googleusercontent.com"
  },
  // アカウントレジストリ (`account:<alias>` = email + refresh_token) と
  // OAuth state nonce (`state:<nonce>`, TTL 600s)。refresh_token は動的な値
  // (テストモードで 7 日失効 → /oauth/callback が再保存) のため KV に置く。
  // ci-dashboard が GitHub OAuth token を KV に置くのと同じ使い分け。
  "kv_namespaces": [
    {
      "binding": "ACCOUNTS",
      "id": "da762434fe1643cfa2047829e61a282c"
    }
  ],
  // Google OAuth client secret (静的)。GCP Secret Manager を source of truth に
  // secrets-inventory 経由で投入する。
  "secrets_store_secrets": [
    {
      "binding": "GOOGLE_CLIENT_SECRET",
      "store_id": "bd7bc91a3e5f4111add4acf6cb4b8733",
      "secret_name": "gmail-mcp-google-client-secret"
    }
  ],
  // ci-workflows/secret-verify-gcp.yml が読む宣言 (org 規約)。
  "secrets": {
    "required": ["gmail-mcp-google-client-secret"]
  },
  "env": {
    "staging": {
      "name": "gmail-mcp-staging",
      "account_id": "24b45709d060d957340180e995f0d373",
      "workers_dev": true,
      "observability": { "enabled": true },
      "routes": [
        {
          "pattern": "gmail-mcp.ippoan.org",
          "custom_domain": true
        }
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://gmail-mcp.ippoan.org",
        "GOOGLE_CLIENT_ID": "747065218280-o3r2c16h8e5023393hjiam2o87f495df.apps.googleusercontent.com"
      },
      "kv_namespaces": [
        {
          "binding": "ACCOUNTS",
          "id": "da762434fe1643cfa2047829e61a282c"
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "GOOGLE_CLIENT_SECRET",
          "store_id": "bd7bc91a3e5f4111add4acf6cb4b8733",
          "secret_name": "gmail-mcp-google-client-secret"
        }
      ]
    }
  }
}
